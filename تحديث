def _slots_adventure_prompt(scenario, stage_idx, balance, total_earned):
    """يرسم رسالة المرحلة الحالية"""
    stage = scenario["stages"][stage_idx]
    header = scenario["title"] if stage_idx == 0 else f"{scenario['title']} — المرحلة {stage_idx + 1}"
    body = f"╭━━━━━ {header} ━━━━━╮\n\n"
    if stage_idx == 0:
        body += f"📖 {scenario['story']}\n\n"
    body += f"{stage['text']}\n\n"
    for i, choice in enumerate(stage["choices"], 1):
        body += f"{i}️⃣ {choice['label']}\n"
    body += f"\n💰 رصيد المغامرة: {balance} 💎 | 📊 إجمالي الربح: {total_earned}\n"
    body += f"\n📝 رد على الرسالة دي برقم اختيارك (1 أو 2 أو 3)\n\n╰━━━━━━━━━━━━━━━━━━╯"
    return body

def _slots_adventure_result(choice):
    """يطبق تأثير الاختيار بشكل عشوائي واقعي"""
    chance = choice.get("chance", 1.0)
    risk = choice.get("risk", 0)
    roll = random.random()
    success = roll < chance
    balance_change = 0
    xp = choice.get("xp", 0)
    desc = ""
    if success:
        balance_change = choice.get("balance", 0)
        desc = choice.get("desc_win", "🍀 حظ سعيد!")
    else:
        balance_change = -risk
        desc = choice.get("desc_lose", "😢 حظ سيء!")
    return balance_change, xp, desc

def _slots_adventure_effects_text(balance_change, xp, desc):
    effects = []
    if balance_change > 0:
        effects.append(f"💰 +{balance_change} 💎")
    elif balance_change < 0:
        effects.append(f"💸 {balance_change} 💎")
    if xp > 0:
        effects.append(f"⭐ +{xp} XP")
    result = f"\n{desc}\n"
    if effects:
        result += "\n" + " | ".join(effects)
    return result

async def start_slots_adventure(client, thread_id, user_id, user_name):
    """يبدأ مغامرة سلوتس جديدة"""
    user = get_user(user_id, user_name)
    if user["balance"] < SLOTS_BET:
        await client.send_message(f"❌ رصيدك غير كافي! تحتاج {SLOTS_BET} 💎", thread_id)
        return
    add_balance(user_id, -SLOTS_BET)
    user["games_played"] += 1
    add_xp(user_id, 5)
    save_users()
    scenario = random.choice(SLOTS_SCENARIOS)
    state = {
        "user_id": str(user_id), "user_name": user_name, "scenario": scenario,
        "stage": 0, "balance": 0, "total_earned": 0, "xp_total": 0, "bet": SLOTS_BET,
    }
    prompt = _slots_adventure_prompt(scenario, 0, 0, 0)
    sent = await client.send_message(prompt, thread_id)
    if sent:
        msg_id = getattr(sent, 'id', None) or sent
        if msg_id:
            slots_adventures[str(msg_id)] = state

async def handle_slots_adventure_reply(client, thread_id, sender_id, sender_name, replied_id, text):
    """يتعامل مع رد اللاعب في مغامرة السلوتس"""
    state = slots_adventures.get(replied_id)
    if not state:
        return False
    if str(sender_id) != state["user_id"]:
        return False
    choice_idx = None
    text_clean = text.strip()
    if text_clean in ("1", "١"):
        choice_idx = 0
    elif text_clean in ("2", "٢"):
        choice_idx = 1
    elif text_clean in ("3", "٣"):
        choice_idx = 2
    if choice_idx is None:
        await client.send_message("⚠️ اكتب 1 أو 2 أو 3!", thread_id)
        return True
    scenario = state["scenario"]
    stage = scenario["stages"][state["stage"]]
    if choice_idx >= len(stage["choices"]):
        await client.send_message("❌ رقم غلط! اكتب 1 أو 2 أو 3.", thread_id)
        return True
    choice = stage["choices"][choice_idx]
    balance_change, xp_gain, desc = _slots_adventure_result(choice)
    state["balance"] += balance_change
    state["total_earned"] += max(0, balance_change)
    state["xp_total"] += xp_gain
    effects_text = _slots_adventure_effects_text(balance_change, xp_gain, desc)
    result_msg = f"✅ اخترت: {choice['label']}{effects_text}"
    await client.send_message(result_msg, thread_id)
    state["stage"] += 1
    if state["stage"] >= len(scenario["stages"]):
        total_prize = state["balance"] + state["bet"]
        if total_prize < 0:
            total_prize = 0
        if state["balance"] > 200:
            ending = scenario["ending_win"]
            add_balance(state["user_id"], total_prize)
            add_xp(state["user_id"], state["xp_total"])
            effects = random.choice(["🎆 🎇 ✨", "💎 💰 ⭐", "🌟 🎖️ 🎊", "🚀 🌌 💫"])
            await client.send_message(
                f"╭━━━━━ 🏆 انتهت المغامرة! {effects} ━━━━━╮\n\n"
                f"{ending}\n\n"
                f"💰 إجمالي الربح: {state['balance']} 💎\n"
                f"⭐ XP: +{state['xp_total']}\n"
                f"💎 رصيدك الحالي: {get_user(state['user_id'])['balance']}\n\n"
                f"╰━━━━━━━━━━━━━━━━━━╯", thread_id)
            user = get_user(state["user_id"], state["user_name"])
            user["wins"] += 1
        elif state["balance"] > 0:
            ending = scenario.get("ending_break_even", "😐 طلعت بربح بسيط!")
            add_balance(state["user_id"], total_prize)
            add_xp(state["user_id"], state["xp_total"] // 2)
            await client.send_message(
                f"╭━━━━━ 😐 انتهت المغامرة ━━━━━╮\n\n"
                f"{ending}\n\n"
                f"💰 ربح بسيط: {state['balance']} 💎\n"
                f"⭐ XP: +{state['xp_total'] // 2}\n"
                f"💎 رصيدك الحالي: {get_user(state['user_id'])['balance']}\n\n"
                f"╰━━━━━━━━━━━━━━━━━━╯", thread_id)
            user = get_user(state["user_id"], state["user_name"])
            user["wins"] += 1
        else:
            ending = scenario["ending_lose"]
            add_xp(state["user_id"], state["xp_total"] // 2)
            await client.send_message(
                f"╭━━━━━ 💔 انتهت المغامرة ━━━━━╮\n\n"
                f"{ending}\n\n"
                f"💰 خسرت: {abs(state['balance'])} 💎\n"
                f"⭐ XP: +{state['xp_total'] // 2}\n"
                f"💎 رصيدك الحالي: {get_user(state['user_id'])['balance']}\n\n"
                f"╰━━━━━━━━━━━━━━━━━━╯", thread_id)
            user = get_user(state["user_id"], state["user_name"])
            user["losses"] += 1
        save_users()
        del slots_adventures[replied_id]
        return True
    prompt = _slots_adventure_prompt(scenario, state["stage"], state["balance"], state["total_earned"])
    sent = await client.send_message(prompt, thread_id)
    if sent:
        msg_id = getattr(sent, 'id', None) or sent
        if msg_id:
            slots_adventures[str(msg_id)] = state
            del slots_adventures[replied_id]
    return True

