active_xo_games = {}

def render_xo_board(board):
    symbols = {" ": "⬜", "X": "❌", "O": "⭕"}
    rows = []
    for r in range(3):
        rows.append("".join(symbols[board[r * 3 + c]] for c in range(3)))
    return "\n".join(rows)

def check_xo_winner(board):
    lines = [
        (0, 1, 2), (3, 4, 5), (6, 7, 8),
        (0, 3, 6), (1, 4, 7), (2, 5, 8),
        (0, 4, 8), (2, 4, 6),
    ]
    for a, b, c in lines:
        if board[a] != " " and board[a] == board[b] == board[c]:
            return board[a]
    if " " not in board:
        return "draw"
    return None

async def game_xo_start(client, thread_id, p1_id, p1_name, p2_id, p2_name):
    if thread_id in active_xo_games:
        await client.send_message("⚠️ فيه لعبة إكس أو شغالة في المجموعة دي بالفعل!", thread_id)
        return
    first, second = random.sample([(p1_id, p1_name, "X"), (p2_id, p2_name, "O")], 2)
    active_xo_games[thread_id] = {
        "board": [" "] * 9,
        "players": {str(first[0]): first[2], str(second[0]): second[2]},
        "names": {str(first[0]): first[1], str(second[0]): second[1]},
        "turn": str(first[0]),
        "order": [str(first[0]), str(second[0])],
    }
    await client.send_message(
        f"╭━━━━━ ❌⭕ إكس أو ━━━━━╮\n\n"
        f"👤 {first[1]} = ❌ | 👤 {second[1]} = ⭕\n\n"
        f"{render_xo_board(active_xo_games[thread_id]['board'])}\n\n"
        f"🎯 دور: {first[1]}\n📝 اكتب رقم الخانة (1-9)\n\n╰━━━━━━━━━━━━━━━━━━╯",
        thread_id
    )

async def handle_xo_move(client, thread_id, sender_id, sender_name, text):
    game = active_xo_games.get(thread_id)
    if not game or str(sender_id) not in game["players"]:
        return False
    if not text.isdigit() or not (1 <= int(text) <= 9):
        return False
    if str(sender_id) != game["turn"]:
        return True  # نص رقمي بس مش دوره، تجاهل بهدوء
    pos = int(text) - 1
    if game["board"][pos] != " ":
        await client.send_message("⚠️ الخانة دي متحجزة، اختر تانية!", thread_id)
        return True
    game["board"][pos] = game["players"][str(sender_id)]
    result = check_xo_winner(game["board"])
    if result == "draw":
        await client.send_message(
            f"{render_xo_board(game['board'])}\n\n🤝 تعادل!",
            thread_id
        )
        del active_xo_games[thread_id]
        return True
    if result in ("X", "O"):
        winner_id = str(sender_id)
        winner_name = game["names"][winner_id]
        prize = 400
        new_balance = add_balance(winner_id, prize)
        add_xp(winner_id, 20)
        await client.send_message(
            f"{render_xo_board(game['board'])}\n\n"
            f"🏆 {winner_name} فاز! +{prize} 💎 (رصيده: {new_balance})",
            thread_id
        )
        del active_xo_games[thread_id]
        return True
    # الدور للاعب التاني
    next_id = [pid for pid in game["order"] if pid != str(sender_id)][0]
    game["turn"] = next_id
    await client.send_message(
        f"{render_xo_board(game['board'])}\n\n🎯 دور: {game['names'][next_id]}",
        thread_id
    )
    return True

