    today = datetime.now()
    last_day = calendar.monthrange(today.year, today.month)[1]
    return last_day - today.day

async def reset_season(client):
    ranked = sorted(users_data.items(), key=lambda x: x[1].get("season_points", 0), reverse=True)
    top3 = ranked[:3]
    rewards = [5000, 3000, 1000]
    medals = ["🥇", "🥈", "🥉"]
    lines = []
    for i, (uid, data) in enumerate(top3):
