# ==================== تهدئة تلقائية (Rate Limiting + محاكاة سلوك بشري) ====================
# بتحد من عدد الرسايل اللي البوت بيبعتها في فترة زمنية معينة، وبتضيف تأخير
# عشوائي شبه طبيعي قبل كل رسالة (زي وقت الكتابة الحقيقي)، عشان تقلل خطر إن
# فيسبوك يلاحظ نمط سلوك آلي ثابت (رد فوري كل مرة، بفاصل زمني منتظم تمامًا)
# ويوقف الحساب. بتشتغل تلقائيًا على أي send_message في أي مكان في الكود
# من غير ما نحتاج نلمس كل استدعاء لوحده.
RATE_LIMIT_MAX_MESSAGES = 15
RATE_LIMIT_WINDOW_SECONDS = 60
_send_timestamps = deque()
_original_send_message = client.send_message

def _estimate_human_delay(text):
    """بيحسب تأخير شبه واقعي بناءً على طول النص، زي وقت كتابة شخص حقيقي تقريبًا"""
    if not text:
        return random.uniform(0.4, 1.0)
    chars_per_second = random.uniform(8, 14)  # سرعة كتابة معقولة ومتغيرة
    delay = len(str(text)) / chars_per_second
    return min(max(delay, 0.6), 6.0)

async def _rate_limited_send_message(*args, **kwargs):
    now = time.time()
    while _send_timestamps and now - _send_timestamps[0] > RATE_LIMIT_WINDOW_SECONDS:
        _send_timestamps.popleft()
    if len(_send_timestamps) >= RATE_LIMIT_MAX_MESSAGES:
        wait_time = RATE_LIMIT_WINDOW_SECONDS - (now - _send_timestamps[0]) + random.uniform(1.0, 4.0)
        print(f"⏳ تهدئة تلقائية: البوت بعت رسايل كتير بسرعة، مستنيين {wait_time:.1f} ثانية...")
        await asyncio.sleep(max(wait_time, 0))

    # تأخير شبه بشري قبل كل رسالة (مش رد فوري بالمللي ثانية زي بوت واضح)
    text_arg = args[0] if args else kwargs.get("text", "")
    await asyncio.sleep(_estimate_human_delay(text_arg))

    _send_timestamps.append(time.time())
    return await _original_send_message(*args, **kwargs)

client.send_message = _rate_limited_send_message

