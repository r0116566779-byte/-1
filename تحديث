async def game_bet(client, thread_id, user1_id, user1_name, user2_id, user2_name):
    user1, user2 = get_user(user1_id, user1_name), get_user(user2_id, user2_name)
    bet_amount = 300
    if user1["balance"] < bet_amount or user2["balance"] < bet_amount:
        await client.send_message("❌ أحد اللاعبين رصيده غير كافي!", thread_id)
        return
    add_balance(user1_id, -bet_amount)
    add_balance(user2_id, -bet_amount)
    options = ["🎲 حجر", "📄 ورقة", "✂️ مقص"]
    p1, p2 = random.choice(options), random.choice(options)
    if p1 == p2:
        add_balance(user1_id, bet_amount)
        add_balance(user2_id, bet_amount)
        result = "🤝 تعادل!"
    elif (p1 == "🎲 حجر" and p2 == "✂️ مقص") or (p1 == "📄 ورقة" and p2 == "🎲 حجر") or (p1 == "✂️ مقص" and p2 == "📄 ورقة"):
        add_balance(user1_id, bet_amount * 2)
        result = f"🏆 {user1_name} فاز! +{bet_amount*2}"
        user1["wins"] += 1
        user2["losses"] += 1
    else:
        add_balance(user2_id, bet_amount * 2)
        result = f"🏆 {user2_name} فاز! +{bet_amount*2}"
        user2["wins"] += 1
        user1["losses"] += 1
    save_users()
    await client.send_message(
        f"╭━━━━━ 🤝 رهان ━━━━━╮\n\n"
        f"👤 {user1_name}: {p1}\n👤 {user2_name}: {p2}\n\n{result}\n\n╰━━━━━━━━━━━━━━━━━━╯",
        thread_id
    )

