async def is_group_admin(client, thread_id, user_id):
    """يتحقق إذا كان المستخدم أدمن في المجموعة"""
    try:
        info_tuple = await client.fetch_thread_info([thread_id])
        if info_tuple and len(info_tuple) > 0:
            info = info_tuple[0]
            admin_ids = (
                getattr(info, 'admin_ids', None)
                or getattr(info, 'admins', None)
                or getattr(info, 'admin_ids_list', None)
                or []
            )
            # بعض النسخ قد ترجع كائنات بدل أرقام
            normalized = []
            for a in admin_ids:
                aid = getattr(a, 'uid', None) or getattr(a, 'id', None) or a
                normalized.append(str(aid))
            return str(user_id) in normalized
    except Exception:
        pass
    return False

async def can_manage_group(client, thread_id, user_id):
    """المطور مسموح دائمًا + أدمن المجموعة الحالية"""
    if str(user_id) == str(DEV_ID):
        return True
    return await is_group_admin(client, thread_id, user_id)

