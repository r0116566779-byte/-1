def _find_ffmpeg():
    """يبحث عن ffmpeg في النظام"""
    import shutil
    ffmpeg_path = shutil.which('ffmpeg')
    if ffmpeg_path:
        return ffmpeg_path
    # نبحث في مسارات شائعة
    for path in ['/usr/bin/ffmpeg', '/usr/local/bin/ffmpeg', '/opt/homebrew/bin/ffmpeg']:
        if os.path.exists(path):
            return path
    return None

FFMPEG_PATH = _find_ffmpeg()
FFMPEG_AVAILABLE = FFMPEG_PATH is not None

async def _compress_video(input_file, output_file, target_size_mb=20):
    """يضغط الفيديو باستخدام ffmpeg لتقليل الحجم"""
    if not FFMPEG_AVAILABLE:
        return False
    try:
        import subprocess
        # حساب bitrate المستهدف
        duration_cmd = [FFMPEG_PATH, '-i', input_file, '-hide_banner']
        result = subprocess.run(duration_cmd, capture_output=True, text=True)
        # استخراج المدة
        duration = 0
        for line in result.stderr.split('\n'):
            if 'Duration' in line:
                time_str = line.split('Duration: ')[1].split(',')[0]
                h, m, s = time_str.split(':')
                duration = int(h) * 3600 + int(m) * 60 + float(s)
                break
        if duration == 0:
            duration = 60  # افتراضي
        target_bits = (target_size_mb * 8 * 1024 * 1024) / duration
        video_bitrate = int(target_bits * 0.85)
        audio_bitrate = min(128000, int(target_bits * 0.15))

        cmd = [
            FFMPEG_PATH, '-y', '-i', input_file,
            '-c:v', 'libx264', '-b:v', f'{video_bitrate}',
            '-c:a', 'aac', '-b:a', f'{audio_bitrate}',
            '-movflags', '+faststart',
            '-preset', 'ultrafast',
            '-threads', '2',
            output_file
        ]
        subprocess.run(cmd, capture_output=True, timeout=300)
        return os.path.exists(output_file) and os.path.getsize(output_file) > 0
    except Exception:
        return False

async def _download_with_ytdlp(url, base_name, audio_only=False):
    """يحمل باستخدام yt-dlp مع خيارات متعددة"""
    if audio_only:
        ydl_opts = {
            'format': 'bestaudio[ext=m4a]/bestaudio/best',
            'outtmpl': base_name + '.%(ext)s',
            'quiet': True,
            'no_warnings': True,
            'postprocessors': [],
        }
    else:
        ydl_opts = {
            'format': 'best[height<=720][ext=mp4]/best[height<=720]/best[ext=mp4]/worst[ext=mp4]/worst',
            'outtmpl': base_name + '.%(ext)s',
            'quiet': True,
            'no_warnings': True,
            'merge_output_format': 'mp4',
            'postprocessors': [],
        }

    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=True)
            title = info.get('title', 'فيديو')
            duration = info.get('duration', 0)

        # نلاقي الملف
        actual_file = None
        actual_ext = None
        for f in sorted(os.listdir('.'), key=lambda x: os.path.getmtime(os.path.join('.', x)), reverse=True):
            if f.startswith(base_name + '.'):
                actual_file = f
                actual_ext = f.split('.')[-1]
                break

        return actual_file, title, duration, actual_ext
    except Exception as e:
        return None, str(e), 0, None

