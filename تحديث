    success = roll < chance
    health = choice.get("health", 0)
    armor = choice.get("armor", 0)
    gold = choice.get("gold", 0)
    xp = choice.get("xp", 0)
    soldiers = choice.get("soldiers", 0)
    if success:
        desc = choice.get("desc_win", "✅ نجحت!")
        if risk > 0 and random.random() < 0.15:
            health -= int(risk * 0.3)
            desc += " (بس جرحت شوية!)"
    else:
        desc = choice.get("desc_lose", "❌ فشلت!")
        health = choice.get("health", 0) - int(risk * 0.5)
        armor = choice.get("armor", 0) - int(risk * 0.2)
        soldiers = choice.get("soldiers", 0) - int(abs(soldiers) * 0.5) if soldiers < 0 else soldiers
        gold = int(gold * 0.3)
    return health, armor, gold, xp, soldiers, desc

def _war_adventure_effects_text(health, armor, gold, xp, soldiers, desc):
    """يرسم نص التأثيرات بشكل بصري"""
    effects = []
    if health != 0:
        sign = "+" if health > 0 else ""
        effects.append(f"❤️ {sign}{health}% صحة")
    if armor != 0:
        sign = "+" if armor > 0 else ""
        effects.append(f"🛡️ {sign}{armor}% درع")
    if gold != 0:
        sign = "+" if gold > 0 else ""
        effects.append(f"💰 {sign}{gold} ذهب")
    if soldiers != 0:
        sign = "+" if soldiers > 0 else ""
        effects.append(f"⚔️ {sign}{abs(soldiers)} جندي")
    if xp > 0:
        effects.append(f"⭐ +{xp} XP")
    body = f"\n{desc}\n"
    if effects:
        body += "\n" + " | ".join(effects)
    return body

