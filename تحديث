                info = ydl.extract_info(url, download=False)
                title = info.get('title', 'ملف')
                duration = info.get('duration', 0)
                is_video = info.get('vcodec', 'none') != 'none'
                is_audio = info.get('acodec', 'none') != 'none'
                filesize_approx = info.get('filesize_approx', 0) or info.get('filesize', 0)
        except Exception:
            title = "ملف"
            duration = 0
            is_video = True
            is_audio = True
