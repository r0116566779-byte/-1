def get_user(user_id, name=""):
    user_id = str(user_id)
    if user_id not in users_data:
        users_data[user_id] = {
            "name": name, "balance": 500, "games_played": 0,
            "wins": 0, "losses": 0, "total_earned": 0,
            "total_lost": 0, "warnings": 0, "last_daily": "",
            "xp": 0, "title": "",
        }
        save_users()
    if name and name != "مستخدم" and users_data[user_id]["name"] != name:
        users_data[user_id]["name"] = name
        save_users()
    # توافق مع مستخدمين قدامى ما عندهمش الحقول الجديدة
    users_data[user_id].setdefault("xp", 0)
    users_data[user_id].setdefault("title", "")
    users_data[user_id].setdefault("xp_boost_until", 0)
    users_data[user_id].setdefault("prize_boost_until", 0)
    users_data[user_id].setdefault("memory_notes", [])
    users_data[user_id].setdefault("season_points", 0)
    return users_data[user_id]

def add_balance(user_id, amount):
    user = get_user(user_id)
    if amount > 0 and time.time() < user.get("prize_boost_until", 0):
        amount *= 2
    user["balance"] += amount
    if amount > 0:
        user["total_earned"] += amount
        user["season_points"] = user.get("season_points", 0) + amount
    else:
        user["total_lost"] += abs(amount)
    save_users()
    return user["balance"]

def add_xp(user_id, amount):
    user = get_user(user_id)
    if time.time() < user.get("xp_boost_until", 0):
        amount *= 2
    user["xp"] = user.get("xp", 0) + amount
    save_users()
    return user["xp"]

def get_level(xp):
    return (xp // 100) + 1

def get_level_progress(xp):
    level = get_level(xp)
    current_floor = (level - 1) * 100
    into_level = xp - current_floor
    return level, into_level, 100

def render_arabic(text):
    """يظبط اتجاه وشكل النص العربي عشان يترسم صح في الصور (لو المكتبات متاحة)"""
    if ARABIC_SUPPORT and text:
        try:
            reshaped = arabic_reshaper.reshape(text)
            return get_display(reshaped)
        except Exception:
            return text

def _vertical_gradient(size, top_color, bottom_color):
    W, H = size
    base = Image.new("RGB", size, top_color)
    top = Image.new("RGB", size, bottom_color)
    mask = Image.new("L", size)
    mask_data = []
    for y in range(H):
        mask_data.extend([int(255 * (y / H))] * W)
    mask.putdata(mask_data)
    base.paste(top, (0, 0), mask)
    return base

def _rounded_rect(draw, box, radius, **kwargs):
    """رسم مستطيل بحواف دائرية، مع دعم احتياطي لو النسخة القديمة من Pillow متدعمش rounded_rectangle"""
    try:
        draw.rounded_rectangle(box, radius=radius, **kwargs)
    except AttributeError:
        draw.rectangle(box, **kwargs)

