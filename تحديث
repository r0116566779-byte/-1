AUCTION_DURATION = 90  # ثانية

async def resolve_auction_after_delay(client, thread_id, auction):
    await asyncio.sleep(AUCTION_DURATION)
    # لو حد بدأ مزاد جديد في نفس المجموعة قبل ما ده يخلص، متبقاش نحل المزاد القديم
    if active_auctions.get(thread_id) is not auction:
        return
    del active_auctions[thread_id]

    if not auction["bidder_id"]:
        await client.send_message(
            f"⌛ انتهى المزاد على \"{auction['description']}\" من غير أي مزايدات!",
            thread_id
        )
        return

    bidder = get_user(auction["bidder_id"], auction["bidder_name"])
    if bidder["balance"] < auction["current_bid"]:
        await client.send_message(
            f"⌛ انتهى المزاد، بس {auction['bidder_name']} رصيده بقى غير كافي وقت الدفع! اتلغى المزاد.",
            thread_id
        )
        return

    add_balance(auction["bidder_id"], -auction["current_bid"])
    add_balance(auction["seller_id"], auction["current_bid"])
    await client.send_message(
        f"╭━━━━━ ⌛ انتهى المزاد ━━━━━╮\n\n"
        f"📦 على: {auction['description']}\n"
        f"🏆 الفايز: {auction['bidder_name']} بمبلغ {auction['current_bid']} 💎\n"
        f"💰 الفلوس اتحولت لـ {auction['seller_name']}\n\n"
        f"╰━━━━━━━━━━━━━━━━━━╯",
        thread_id
    )

