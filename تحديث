                        return
                    else:
                        await client.send_message(f"❌ فشل تحميل الصورة (كود {resp.status})", thread_id)
                        return

        # لو الرابط صوتي فقط أو المستخدم طلب صوت
        if not is_video and is_audio:
            await client.send_message(f"🎵 {user_name} بيحمل صوت... ({duration_str})", thread_id)
            actual_file, title, duration, ext = await _download_with_ytdlp(url, base_name, audio_only=True)
