# ==================== إعادة اتصال تلقائية عند الانقطاع ====================
# لو الجلسة اتقطعت لأي سبب (مشكلة شبكة، فيسبوك قفل الاتصال مؤقتًا، إلخ)،
# البوت يحاول يعيد الاتصال تلقائيًا بدل ما يوقف تمامًا ويحتاج تشغيل يدوي.
def run_with_auto_reconnect():
    attempt = 0
    while True:
        try:
            client.run()
            # لو client.listen() رجع عادي (من غير استثناء)، يبقى غالبًا حصل خروج مقصود
            print("🛑 البوت وقف بشكل طبيعي.")
            break
        except KeyboardInterrupt:
            print("🛑 تم إيقاف البوت يدويًا (Ctrl+C).")
            break
        except Exception as e:
            attempt += 1
            wait_time = min(30 * attempt, 300)  # يزيد وقت الانتظار تدريجيًا لحد 5 دقايق
            print(f"⚠️ انقطع الاتصال بالبوت (محاولة رقم {attempt}): {e}")
            print(f"🔁 هيحاول يعيد الاتصال بعد {wait_time} ثانية...")
            time.sleep(wait_time)

run_with_auto_reconnect()
