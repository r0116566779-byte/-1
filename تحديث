# ==================== صورة (بحث وإرسال صور عبر DuckDuckGo مباشرة) ====================
async def ddg_image_search(session, query, max_results=20):
    # الخطوة 1: جلب رمز vqd المطلوب من DuckDuckGo
    async with session.get(
        "https://duckduckgo.com/",
        params={"q": query},
        timeout=aiohttp.ClientTimeout(total=10)
    ) as resp:
        html = await resp.text()
    match = re.search(r"vqd=['\"]?([\d-]+)['\"]?", html)
    if not match:
        match = re.search(r"vqd=([\d-]+)&", html)
    if not match:
        return []
    vqd = match.group(1)

    # الخطوة 2: طلب نتائج الصور فعليًا
    async with session.get(
        "https://duckduckgo.com/i.js",
        params={
            "q": query, "o": "json", "vqd": vqd,
            "f": ",,,,,", "p": "1"
        },
        headers={"Referer": "https://duckduckgo.com/"},
        timeout=aiohttp.ClientTimeout(total=10)
    ) as resp:
        if resp.status != 200:
            return []
        data = await resp.json(content_type=None)
    return [item["image"] for item in data.get("results", [])[:max_results] if item.get("image")]

async def game_image(client, thread_id, query, user_name, count=5):
    if not query:
        await client.send_message(
            "⚠️ اكتب اسم الصورة اللي عايزها!\nمثال: .صورة غوجو",
            thread_id
        )
        return
    downloaded_files = []
    try:
        headers = {"User-Agent": "Mozilla/5.0"}
        async with aiohttp.ClientSession(headers=headers) as session:
            image_urls = await ddg_image_search(session, query, max_results=25)
            if not image_urls:
                await client.send_message(f"❌ ما لقيتش صور لـ: {query}", thread_id)
                return
            random.shuffle(image_urls)
            for image_url in image_urls:
                if len(downloaded_files) >= count:
                    break
                try:
                    async with session.get(image_url, timeout=aiohttp.ClientTimeout(total=15)) as resp:
                        content_type = resp.headers.get("Content-Type", "")
                        if resp.status == 200 and content_type.startswith("image/"):
                            data = await resp.read()
                            ext = content_type.split("/")[-1].split(";")[0].strip()
                            if ext == "jpeg":
                                ext = "jpg"
                            elif ext not in ("jpg", "png", "gif", "webp"):
                                ext = "jpg"
                            filename = f"img_{int(time.time()*1000)}_{len(downloaded_files)}.{ext}"
                            with open(filename, "wb") as f:
                                f.write(data)
                            downloaded_files.append(filename)
                except Exception:
                    continue
        if not downloaded_files:
            await client.send_message(f"❌ تعذر تحميل صور صالحة لـ: {query}", thread_id)
            return
        await client.send_message(
            text=f"🖼️ {user_name} طلب: {query} ({len(downloaded_files)} صور)",
            thread_id=thread_id,
            file_path=downloaded_files
        )
    except Exception:
        await client.send_message("❌ حدث خطأ أثناء جلب الصور، جرب طلب تاني!", thread_id)
    finally:
        for f in downloaded_files:
            try:
                os.remove(f)
            except:
                pass

