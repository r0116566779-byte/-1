def extract_uid_from_url(url: str) -> str:
    url = url.strip()
    patterns = [
        r'facebook\.com/profile\.php\?id=(\d+)',
        r'facebook\.com/([a-zA-Z0-9._-]+)/?$',
        r'facebook\.com/([a-zA-Z0-9._-]+)\?',
        r'fb\.com/([a-zA-Z0-9._-]+)',
    ]
    for pattern in patterns:
        match = re.search(pattern, url)
        if match:
            return match.group(1)
    return None

