async def handle_war_adventure_reply(client, thread_id, sender_id, sender_name, replied_id, text):
    """يتعامل مع رد اللاعب في المغامرة الحربية"""
    state = war_adventures.get(replied_id)
    if not state:
        return False
    if str(sender_id) != state["user_id"]:
        return False
    choice_idx = None
    text_clean = text.strip()
    if text_clean in ("1", "١"):
        choice_idx = 0
    elif text_clean in ("2", "٢"):
        choice_idx = 1
    elif text_clean in ("3", "٣"):
        choice_idx = 2
    if choice_idx is None:
        await client.send_message("⚠️ اكتب 1 أو 2 أو 3!", thread_id)
        return True
    scenario = state["scenario"]
    stage = scenario["stages"][state["stage"]]
    if choice_idx >= len(stage["choices"]):
        await client.send_message("❌ رقم غلط! اكتب 1 أو 2 أو 3.", thread_id)
        return True
    choice = stage["choices"][choice_idx]
    health_change, armor_change, gold_change, xp_gain, soldiers_change, desc = _war_adventure_result(choice)
    state["health"] = max(0, min(100, state["health"] + health_change))
    state["armor"] = max(0, min(100, state["armor"] + armor_change))
    state["gold"] = max(0, state["gold"] + gold_change)
    state["soldiers"] = max(0, state["soldiers"] + soldiers_change)
    state["xp_total"] += xp_gain
    effects_text = _war_adventure_effects_text(health_change, armor_change, gold_change, xp_gain, soldiers_change, desc)
    result_msg = f"✅ اخترت: {choice['label']}{effects_text}"
    await client.send_message(result_msg, thread_id)
    if state["health"] <= 0 or state["soldiers"] <= 0:
        ending = scenario["ending_lose"]
        await client.send_message(
            f"╭━━━━━ 💀 انتهت المغامرة ━━━━━╮\n\n"
            f"{ending}\n\n"
            f"💰 جمعت: {state['gold']} ذهب\n"
            f"⭐ XP: {state['xp_total']}\n"
            f"⚔️ جنود باقين: {state['soldiers']}\n\n"
            f"╰━━━━━━━━━━━━━━━━━━╯", thread_id)
        user = get_user(state["user_id"], state["user_name"])
        user["losses"] += 1
        save_users()
        del war_adventures[replied_id]
        return True
    state["stage"] += 1
    if state["stage"] >= len(scenario["stages"]):
        ending = scenario["ending_win"]
        performance_bonus = state["gold"] + (state["health"] // 10) + (state["soldiers"] // 5)
        total_prize = state["bet"] * 2 + performance_bonus
        add_balance(state["user_id"], total_prize)
        add_xp(state["user_id"], state["xp_total"])
        effects = random.choice(["🎆 🎇 ✨", "🔥 ⚔️ 🏆", "💎 💰 ⭐", "🌟 🎖️ 🎊"])
        await client.send_message(
            f"╭━━━━━ 🏆 انتصرت! {effects} ━━━━━╮\n\n"
            f"{ending}\n\n"
            f"💰 جائزة: {total_prize} 💎\n"
            f"⭐ XP: +{state['xp_total']}\n"
            f"❤️ صحتك: {state['health']}% | ⚔️ جنودك: {state['soldiers']}\n\n"
            f"╰━━━━━━━━━━━━━━━━━━╯", thread_id)
        user = get_user(state["user_id"], state["user_name"])
        user["wins"] += 1
        save_users()
        del war_adventures[replied_id]
        return True
    prompt = _war_adventure_prompt(scenario, state["stage"], state["health"], state["armor"], state["gold"], state["soldiers"])
    sent = await client.send_message(prompt, thread_id)
    if sent:
        msg_id = getattr(sent, 'id', None) or sent
        if msg_id:
            war_adventures[str(msg_id)] = state
            del war_adventures[replied_id]
    return True

