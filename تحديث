            continue
        add_balance(uid, rewards[i])
        lines.append(f"{medals[i]} {data.get('name', 'مجهول')} — {data.get('season_points', 0)} نقطة (+{rewards[i]} 💎)")

    for uid in users_data:
        users_data[uid]["season_points"] = 0
